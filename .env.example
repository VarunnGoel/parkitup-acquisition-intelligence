# =====================================================================
# PARK It Up Acquisition Intelligence - environment template
#
# Copy to .env and fill in local values:   cp .env.example .env
# .env is git-ignored and must NEVER be committed.
# This template contains placeholders only - no real credentials.
# =====================================================================

# --- PostgreSQL connection -------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=parkitup
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password

# Schema all project objects live in. Change only if it collides locally.
PG_SCHEMA=parkitup

# Scratch database used by scripts/validate_schema.sh. Created and dropped on
# every run, so it must NOT be a database you care about.
VALIDATE_DB=parkitup_validate

# --- synthetic data generation (source) -----------------------------
# Fixed seed so the generated dataset is reproducible. Anyone cloning this repo
# and running the pipeline must obtain byte-identical data, otherwise no result
# in the documentation can be checked.
RANDOM_SEED=20260815

# Observation window for the simulated performance facts. Must stay inside the
# range seeded into dim_date by database/seeds/02_seed_calendar.sql.
OBS_START_DATE=2025-08-01
OBS_END_DATE=2026-07-31

# Target number of parking lots in the modelled universe.
TARGET_LOT_COUNT=120

# --- OpenStreetMap extraction (source) ------------------------------
# Public Overpass instance. Rate-limited; be considerate and cache responses.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=180

# When true, the ETL uses the committed CSV snapshot in data/external/ instead
# of calling Overpass. Keeps the pipeline runnable offline and in CI.
USE_OSM_CACHE=true

# Date attached to the cached public extract and radius around each selected
# micro-market used during the one-time source collection.
SOURCE_OBSERVED_ON=2026-08-16
MARKET_RADIUS_M=3000
